# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one guild for instant propagation.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to invoke commands.
# SECURITY: set this before shared/deployed use. Empty keeps local compatibility
# but logs a startup warning and allows anyone in a mapped channel.
GJC_BOT_ALLOWED_USERS=

# Set to 1 for shared/production deployments. The bot refuses to start when
# this is enabled and GJC_BOT_ALLOWED_USERS is empty. Startup-only; restart the
# bot after changing either authorization setting.
GJC_REMOTE_REQUIRE_ALLOWLIST=0

# Path to channels.json (defaults to ../channels.json next to this bot package).
CHANNELS_CONFIG=

# Port the bot's WebSocket server listens on for incoming host-daemon connections.
HOST_WS_PORT=7711

# Pre-shared per-host auth tokens: "hostId1:token1,hostId2:token2"
# Must match HOST_TOKEN set in each host daemon's own .env.
# Every hostId referenced by channels.json must have exactly one entry here.
HOST_TOKENS=
# Note: Provider authentication (e.g. a Copilot token) is set up directly on
# each daemon host: run `gjc` interactively and use `/login <provider>` once.
# The saved token in ~/.gjc is reused by every SDK session the daemon creates.
#
# Set to 1 to log Discord interaction lifecycle and relayed GJC event summaries.
GJC_REMOTE_DEBUG=0
