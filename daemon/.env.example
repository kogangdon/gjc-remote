# Unique identifier for this host, must match a key in HOST_TOKENS on the bot side
# and the "hostId" values referenced in bot/channels.json.
HOST_ID=

# Pre-shared token proving this daemon owns HOST_ID. Must match the bot's HOST_TOKENS entry.
# Set exactly one of HOST_TOKEN or HOST_TOKEN_FILE. Native services may use the
# environment value; the daemon container uses a read-only secret file.
HOST_TOKEN=
# HOST_TOKEN_FILE=/run/secrets/host_token

# Human-readable label shown in bot logs on connect.
HOST_LABEL=

# ws:// or wss:// URL of the bot's WebSocket server (private-network reachable, no need to expose publicly).
BOT_WS_URL=ws://bot-host.internal:7711

# The daemon embeds @gajae-code/coding-agent under Bun and reuses this host's
# normal ~/.gjc credentials and model-role settings. On each session it activates
# the host's configured model profile (config.yml `modelProfile.default`) via
# GJC's own resolver, so the daemon runs the same model your interactive GJC does.
# No GJC executable path or copied credential is required.
#
# Optional: override the activated profile name (defaults to config.yml
# `modelProfile.default`). Leave unset to follow the host configuration.
# GJC_MODEL_PROFILE=
#
# Optional readiness protocol v2. This does not enable native workspace serving
# by itself. Set GJC_READINESS_V2=1 to advertise the capability.
# GJC_READINESS_TTL_MS is bounded from 1000 through 60000 milliseconds and
# defaults to 60000. It does not enable v2 by itself.
# GJC_READINESS_V2=0
# GJC_READINESS_TTL_MS=60000
#
# Test-only daemon-local workspace inventory for contract scaffolding. Never set
# these variables in deployment: enabling the injection flag deliberately
# selects the fixture provider. Tests must also set
# GJC_READINESS_TEST_INJECTION=1; this is never a native inventory fallback.
# The fixture must contain the binding identity and local workDir.
# GJC_READINESS_TEST_INJECTION=1
# GJC_WORKSPACE_INVENTORY=<canonical test-only inventory-v2 JSON>

# Signed native inventory Reader configuration. GJC_NATIVE_INVENTORY_MODE selects
# off (default) or verify; any other value fails the daemon closed at startup.
# In verify mode, daemon boot constructs and self-tests the signed production
# native Reader. Missing role bindings, an unsupported platform, or failed
# native proof terminates startup. The inventory remains capability evidence;
# the authenticated #44 mapping envelope is the sole route authority.
#
# Native workspace serving remains OFF by default. It can be considered only
# when GJC_NATIVE_WORKSPACE_SERVING is exactly 1 and verify mode successfully
# advertises the production inventory-receipt capability. Each lifecycle
# operation also retains its own fail-closed dependency and authority gates.
# Readiness or verify mode alone never enables serving, and live serving-on
# release evidence remains a separate deployment obligation.
# GJC_NATIVE_INVENTORY_MODE=off
# GJC_NATIVE_WORKSPACE_SERVING=0
# Verify mode or the exact serving opt-in requires an exact protocol-v3 bot
# response with readiness, inventory-receipt, and bind-authority-verification
# capabilities. Lower responses are rejected; the daemon never negotiates down.
#
# For verify mode, supply exactly five platform-local principals as strict JSON.
# Linux uses canonical
# uid:<decimal>; Windows uses canonical uppercase SIDs. The system principal is
# uid:0 on Linux or S-1-5-18 on Windows, with all five values distinct. WSL
# Linux and Windows accounts are separate identity systems. This example is
# synthetic; deployment must use the provisioned local principals without
# publishing their identities, paths, or ACL evidence.
# GJC_INVENTORY_ROLE_BINDINGS={"management":{"kind":"uid","value":"uid:1001"},"bot":{"kind":"uid","value":"uid:1002"},"recovery":{"kind":"uid","value":"uid:1003"},"daemon":{"kind":"uid","value":"uid:1004"},"system":{"kind":"uid","value":"uid:0"}}
