{
  "name": "gjc-remote",
  "version": "0.4.0-rc.3",
  "private": true,
  "description": "Discord-controlled remote GJC sessions: bot (Discord + WS relay server) + daemon (per-host WebSocket bridge with pooled GJC SDK sessions)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "evidence:issue55": "node scripts/issue55-evidence.js snapshot",
    "evidence:issue55:verify": "node scripts/issue55-evidence.js verify",
    "evidence:issue55:candidate": "node scripts/issue55-evidence.js candidate",
    "evidence:issue55:candidate:verify": "node scripts/issue55-evidence.js verify-candidate",
    "build:service-release": "node native-control/scripts/build-service-release.mjs build",
    "smoke:local": "node scripts/local-smoke.js",
    "smoke:windows-host-fixture": "node scripts/windows-host-smoke.js",
    "release": "node scripts/release.js",
    "test:scripts": "node --test scripts/test/*.test.js",
    "verify:service-release": "node native-control/scripts/build-service-release.mjs verify",
    "test": "npm run test:scripts && npm run test --workspaces --if-present"
  },
  "workspaces": [
    "bot",
    "daemon",
    "native-control",
    "shared"
  ],
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "yaml": "2.8.1"
  }
}
