{
  "name": "@gjc-remote/native-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/public.js",
  "exports": {
    ".": "./src/public.js"
  },
  "bin": {
    "gjc-remote-inventory": "./src/inventory-entrypoint.js",
    "gjc-remote-service": "./src/service-entrypoint.js"
  },
  "nativeControlContract": {
    "version": 4,
    "revision": 4,
    "napi": 8,
    "platforms": [
      "linux-x64",
      "linux-arm64",
      "win32-x64"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node-gyp rebuild && node scripts/verify-build.mjs --write-manifest",
    "verify-build": "node scripts/verify-build.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@gjc-remote/shared": "0.4.0-rc.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "node-gyp": "12.4.0"
  },
  "gypfile": true
}
