{
  "schemaVersion": 1,
  "kind": "gjc-remote-application-release-contract",
  "limits": {
    "manifestBytes": 1048576,
    "signatureBytes": 16384,
    "archiveBytes": 1073741824,
    "unpackedPayloadBytes": 2147483648,
    "inventoryBytes": 33554432,
    "payloadEntries": 100000,
    "pathBytes": 4096,
    "pathSegments": 64,
    "lockBytes": 16777216,
    "packageMetadataBytes": 33554432,
    "producerOutputBytes": 1048576,
    "producerTimeoutMs": 600000
  },
  "repository": "kogangdon/gjc-remote",
  "releaseVersion": "0.4.0-rc.3",
  "releaseTag": "v0.4.0-rc.3",
  "producer": {
    "bunVersion": "1.4.2",
    "executableModeAuthority": {
      "gitExecutableBlobs": "required",
      "packageBins": "required",
      "nativeAddon": "required",
      "otherMaterializedFiles": "producer-filesystem-mode",
      "windowsProducerToLinuxTarget": "refused-before-writes-or-network"
    },
    "installArguments": [
      "install",
      "--production",
      "--frozen-lockfile",
      "--ignore-scripts",
      "--backend=copyfile",
      "--linker=hoisted",
      "--cache-dir=<fresh-cache>",
      "--registry=https://registry.npmjs.org",
      "--os=<target-platform>",
      "--cpu=<target-architecture>"
    ],
    "archive": {
      "format": "posix-ustar",
      "gzipLevel": 6,
      "gzipOperatingSystem": 255,
      "mtimeSeconds": 0,
      "terminalZeroBlocks": 2,
      "paxType": "local",
      "paxKeys": [
        "SCHILY.nlink",
        "mtime",
        "path",
        "size"
      ]
    }
  },
  "targets": [
    {
      "platform": "linux",
      "architecture": "arm64"
    },
    {
      "platform": "linux",
      "architecture": "x64"
    },
    {
      "platform": "win32",
      "architecture": "x64"
    }
  ],
  "sourceWorkspaces": [
    {
      "path": "bot",
      "packageName": "@gjc-remote/bot",
      "packageVersion": "0.4.0-rc.3",
      "productionRoots": [
        "package.json",
        "src"
      ]
    },
    {
      "path": "daemon",
      "packageName": "@gjc-remote/daemon",
      "packageVersion": "0.4.0-rc.3",
      "productionRoots": [
        "package.json",
        "src"
      ]
    },
    {
      "path": "native-control",
      "packageName": "@gjc-remote/native-control",
      "packageVersion": "2.0.0",
      "productionRoots": [
        "deployment-keys/application-trusted.json",
        "deployment-keys/shawl-trusted.json",
        "package.json",
        "release-keys/trusted.json",
        "src"
      ]
    },
    {
      "path": "shared",
      "packageName": "@gjc-remote/shared",
      "packageVersion": "0.4.0-rc.3",
      "productionRoots": [
        "package.json",
        "*.js"
      ]
    }
  ],
  "sourceRootFiles": [
    "bun.lock",
    "package.json"
  ],
  "excludedSegments": [
    ".cache",
    ".env",
    ".git",
    ".gjc",
    ".gjc-remote-session",
    "credentials",
    "logs",
    "sessions"
  ],
  "entrypoints": {
    "bot": "bot/src/bot.js",
    "daemon": "daemon/src/daemon.js"
  },
  "runtimes": {
    "node": {
      "minimumVersion": "26.0.0"
    },
    "bun": {
      "minimumVersion": "1.4.0"
    }
  },
  "nativeControl": {
    "packageName": "@gjc-remote/native-control",
    "packageVersion": "2.0.0",
    "manifestPath": "native-control/build/Release/native-control.manifest.json",
    "signaturePath": "native-control/build/Release/native-control.manifest.json.sig",
    "addonPath": "native-control/build/Release/native_control.node",
    "applicationTrustPath": "native-control/deployment-keys/application-trusted.json",
    "shawlTrustPath": "native-control/deployment-keys/shawl-trusted.json",
    "trustPath": "native-control/release-keys/trusted.json",
    "contractVersion": 5,
    "contractRevision": 1,
    "napi": 8,
    "executablePolicy": "required"
  },
  "wireCapabilities": [
    "gate_presentation_v1",
    "heartbeat",
    "invoke",
    "invoke_cancellation_v1",
    "set_model",
    "terminal_disposition_v1",
    "workspace_bind_authority_verification_v1",
    "workspace_inventory_receipt_v2",
    "workspace_readiness_v2"
  ],
  "sdk": {
    "packageName": "@gajae-code/coding-agent",
    "packageVersion": "0.16.7",
    "lockIntegrity": "sha512-rqhs7FELytNw0zfumqroc5EaVrtEUccGGp4YNpFbycF89o+Q+dzWWof1uRVnZvS+GLzCKR9psWZiDEacJzXY7A==",
    "configSchemaVersion": 2,
    "transcriptVersion": 5,
    "sourceRoots": {
      "settings": "src/config/settings.ts",
      "model": "src/config/model-registry.ts",
      "auth": "src/session/auth-storage.ts",
      "session": "src/session/session-manager.ts"
    },
    "sourceContractDomain": "gjc-remote/sdk-external-state-source/v1",
    "closureDomain": "gjc-remote/sdk-production-closure/v1"
  }
}
